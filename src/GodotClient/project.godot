; Engine configuration file.
; HexTactics — Godot 4.7.2 .NET project (see docs/ARCHITECTURE.md).

config_version=5

[application]

config/name="HexTactics"
config/description="Hexagonal real-time tactics prototype"
config/version="0.4.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0.141, 0.149, 0.169, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="disabled"

[dotnet]

project/assembly_name="HexTactics"
project/solution_directory="../.."

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.141, 0.149, 0.169, 1)
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
